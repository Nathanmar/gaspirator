{
  "name": "gaspirator",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"pnpm --filter native dev\" \"pnpm --filter web dev\" \"cd apps/server && dotnet run\"",
    "build": "pnpm -r build",
    "check-types": "pnpm -r --if-present check-types",
    "dev:web": "pnpm --filter web dev",
    "dev:native": "pnpm --filter native dev",
    "dev:server": "cd apps/server && dotnet run",
    "setup:server": "cd apps/server && dotnet restore",
    "check:server": "cd apps/server && dotnet build --no-restore",
    "test:server": "cd apps/server && dotnet test",
    "setup:part:backend:dotnet:aspnet-mvc": "cd apps/server && dotnet restore",
    "dev:part:backend:dotnet:aspnet-mvc": "cd apps/server && dotnet run",
    "check:part:backend:dotnet:aspnet-mvc": "cd apps/server && dotnet build --no-restore",
    "test:part:backend:dotnet:aspnet-mvc": "cd apps/server && dotnet test",
    "lint:eslint": "eslint .",
    "format:prettier": "prettier --write .",
    "format:prettier:check": "prettier --check .",
    "test": "pnpm --filter web test",
    "prepare": "husky"
  },
  "dependencies": {
    "@my-app/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@my-app/config": "workspace:*",
    "@types/bun": "catalog:",
    "concurrently": "^9.2.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.0"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,astro,svelte}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.8.0"
}
