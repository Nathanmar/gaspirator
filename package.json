{
  "name": "gaspirator",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"turbo -F web dev\" \"pnpm dev:server\"",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "mock": "prism mock openapi.yaml",
    "dev:server": "uv --directory apps/server run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "setup:server": "uv --directory apps/server sync --extra dev",
    "check:server": "uv --directory apps/server run --extra dev ruff check .",
    "test:server": "uv --directory apps/server run --extra dev pytest",
    "setup:part:backend:python:fastapi": "pnpm setup:server",
    "dev:part:backend:python:fastapi": "pnpm dev:server",
    "check:part:backend:python:fastapi": "pnpm check:server",
    "test:part:backend:python:fastapi": "pnpm test:server",
    "test": "pnpm --filter web test",
    "prepare": "husky",
    "lint": "biome check ."
  },
  "lint-staged": {
    "apps/{web,mobile}/**/*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "dependencies": {
    "@gaspirator/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@gaspirator/config": "workspace:*",
    "@stoplight/prism-cli": "^5.16.0",
    "@types/bun": "catalog:",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "turbo": "2.10.11",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.19.0"
}
