    "package.json": "{\n  \"name\": \"my-app\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"workspaces\": [\n    \"apps/*\",\n    \"packages/*\"\n  ],\n  \"scripts\": {\n    \"dev\": \"concurrently --kill-others \\\"pnpm --filter native dev\\\" \\\"pnpm --filter web dev\\\" \\\"bash scripts/native/task-1.sh\\\"\",\n    \"build\": \"pnpm -r build\",\n    \"check-types\": \"pnpm -r --if-present check-types\",\n    \"dev:web\": \"pnpm --filter web dev\",\n    \"dev:native\": \"pnpm --filter native dev\",\n    \"dev:server\": \"bash scripts/native/task-1.sh\",\n    \"setup:server\": \"bash scripts/native/task-2.sh\",\n    \"check:server\": \"bash scripts/native/task-3.sh\",\n    \"test:server\": \"bash scripts/native/task-4.sh\",\n    \"setup:part:backend:dotnet:aspnet-mvc\": \"bash scripts/native/task-2.sh\",\n    \"dev:part:backend:dotnet:aspnet-mvc\": \"bash scripts/native/task-1.sh\",\n    \"check:part:backend:dotnet:aspnet-mvc\": \"bash scripts/native/task-3.sh\",\n    \"test:part:backend:dotnet:aspnet-mvc\": \"bash scripts/native/task-4.sh\",\n    \"lint:eslint\": \"eslint .\",\n    \"format:prettier\": \"prettier --write .\",\n    \"format:prettier:check\": \"prettier --check .\",\n    \"test\": \"pnpm --filter web test\"\n  },\n  \"devDependencies\": {\n    \"concurrently\": \"^9.2.1\",\n    \"typescript\": \"catalog:\",\n    \"@my-app/config\": \"workspace:*\",\n    \"eslint\": \"^10.12.0\",\n    \"@eslint/js\": \"^10.0.1\",\n    \"typescript-eslint\": \"^8.71.0\",\n    \"globals\": \"^17.13.0\",\n    \"prettier\": \"^3.9.9\",\n    \"@types/bun\": \"catalog:\"\n  },\n  \"packageManager\": \"pnpm@10.17.1\",\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@my-app/env\": \"workspace:*\"\n  }\n}\n",
