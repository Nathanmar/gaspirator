    "apps/server/.env.example": "# Environment Configuration\n# Copy this file to .env and update the values\n\n# Application\nDEBUG=true\nHOST=0.0.0.0\nPORT=8000\n\n# Allowed web origin for CORS (unset or empty = allow any origin)\nCORS_ORIGIN=http://localhost:5173\n\n# Database (if using SQLAlchemy/SQLModel)\nDATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gaspirator\n\n# OpenAI (if using AI frameworks)\nOPENAI_API_KEY=your-openai-api-key\n\n# Anthropic (if using Anthropic SDK)\nANTHROPIC_API_KEY=your-anthropic-api-key\n\n# JWT signing\nSECRET_KEY=change-me-to-a-long-random-secret\n\n# Celery (if using task queue)\nCELERY_BROKER_URL=redis://localhost:6379/0\nCELERY_RESULT_BACKEND=redis://localhost:6379/0\n",
    "apps/web/package.json": "{\n  \"name\": \"web\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite dev\",\n    \"build\": \"vite build\",\n    \"serve\": \"vite preview\",\n    \"start\": \"vite\",\n    \"check-types\": \"tsr generate && tsc --noEmit\",\n    \"test\": \"vitest run --passWithNoTests\"\n  },\n  \"dependencies\": {\n    \"@base-ui/react\": \"^1.8.0\",\n    \"class-variance-authority\": \"^0.7.1\",\n    \"clsx\": \"^2.1.1\",\n    \"next-themes\": \"^0.4.6\",\n    \"sonner\": \"^2.0.8\",\n    \"tailwind-merge\": \"^3.7.0\",\n    \"@tailwindcss/vite\": \"^4.3.3\",\n    \"tw-animate-css\": \"^1.4.0\",\n    \"@tanstack/react-router\": \"1.170.41\",\n    \"react\": \"19.2.8\",\n    \"react-dom\": \"19.2.8\",\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@gaspirator/env\": \"workspace:*\",\n    \"zustand\": \"^5.0.15\",\n    \"@tanstack/react-form\": \"^1.33.0\",\n    \"gsap\": \"^3.15.0\",\n    \"lucide-react\": \"^1.21.0\"\n  },\n  \"devDependencies\": {\n    \"@tanstack/react-router-devtools\": \"1.167.0\",\n    \"@tanstack/router-cli\": \"1.167.40\",\n    \"@tanstack/router-plugin\": \"1.168.42\",\n    \"@types/node\": \"^26.6.4\",\n    \"@types/react\": \"~19.2.18\",\n    \"@types/react-dom\": \"~19.2.7\",\n    \"@vitejs/plugin-react\": \"^6.1.1\",\n    \"postcss\": \"^8.5.15\",\n    \"tailwindcss\": \"^4.3.3\",\n    \"vite\": \"^8.3.2\",\n    \"typescript\": \"catalog:\",\n    \"@gaspirator/config\": \"workspace:*\",\n    \"daisyui\": \"^5.7.47\",\n    \"vitest\": \"4.1.8\",\n    \"@vitest/ui\": \"4.1.8\",\n    \"@vitest/coverage-v8\": \"4.1.8\",\n    \"jsdom\": \"^29.1.1\",\n    \"@testing-library/dom\": \"^10.4.2\",\n    \"@testing-library/user-event\": \"^14.6.7\",\n    \"@testing-library/jest-dom\": \"^6.9.1\",\n    \"@testing-library/react\": \"^16.3.3\"\n  }\n}\n",
    "package.json": "{\n  \"name\": \"gaspirator\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"workspaces\": [\n    \"apps/*\",\n    \"packages/*\"\n  ],\n  \"scripts\": {\n    \"dev\": \"concurrently --kill-others \\\"turbo -F web dev\\\" \\\"bash scripts/native/task-1.sh\\\"\",\n    \"build\": \"turbo build\",\n    \"check-types\": \"turbo check-types\",\n    \"dev:web\": \"turbo -F web dev\",\n    \"dev:server\": \"bash scripts/native/task-1.sh\",\n    \"setup:server\": \"bash scripts/native/task-2.sh\",\n    \"check:server\": \"bash scripts/native/task-3.sh\",\n    \"test:server\": \"bash scripts/native/task-4.sh\",\n    \"setup:part:backend:python:fastapi\": \"bash scripts/native/task-2.sh\",\n    \"dev:part:backend:python:fastapi\": \"bash scripts/native/task-1.sh\",\n    \"check:part:backend:python:fastapi\": \"bash scripts/native/task-3.sh\",\n    \"test:part:backend:python:fastapi\": \"bash scripts/native/task-4.sh\",\n    \"test\": \"pnpm --filter web test\"\n  },\n  \"devDependencies\": {\n    \"concurrently\": \"^9.2.1\",\n    \"typescript\": \"catalog:\",\n    \"@gaspirator/config\": \"workspace:*\",\n    \"turbo\": \"2.10.11\",\n    \"@types/bun\": \"catalog:\"\n  },\n  \"packageManager\": \"pnpm@10.17.1\",\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@gaspirator/env\": \"workspace:*\"\n  }\n}\n",
    "packages/config/package.json": "{\n  \"name\": \"@gaspirator/config\",\n  \"version\": \"0.0.0\",\n  \"private\": true\n}\n",
    "packages/env/package.json": "{\n  \"name\": \"@gaspirator/env\",\n  \"version\": \"0.0.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"exports\": {\n    \"./web\": \"./src/web.ts\"\n  },\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@t3-oss/env-core\": \"^0.13.11\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"catalog:\",\n    \"@gaspirator/config\": \"workspace:*\",\n    \"@types/bun\": \"catalog:\"\n  }\n}\n",
