# Base URL of the API contract, without a trailing slash.
# Port 4010 is Prism: the mock (`pnpm mock`) or the validation proxy in front of the API
# (`docker compose up -d db backend prism`), which also answers CORS for the dev server.
VITE_API_URL=http://127.0.0.1:4010
VITE_SERVER_URL=http://localhost:8000
