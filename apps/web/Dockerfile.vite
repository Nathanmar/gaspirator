FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

FROM base AS dev
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    HUSKY=0 \
    CI=true \
    npm_config_store_dir=/pnpm-store
ARG VITE_SERVER_URL=http://localhost:5173
ENV VITE_SERVER_URL=${VITE_SERVER_URL}
ARG VITE_API_URL=http://localhost:8000/api/v1
ENV VITE_API_URL=${VITE_API_URL}
EXPOSE 5173
CMD ["sh", "-c", "pnpm install --frozen-lockfile --filter web... && pnpm --filter web dev --host 0.0.0.0 --port 5173"]

FROM base AS builder
COPY . .
RUN if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi
ARG VITE_SERVER_URL=http://localhost:5173
ENV VITE_SERVER_URL=${VITE_SERVER_URL}
ARG VITE_API_URL=http://localhost:8000/api/v1
ENV VITE_API_URL=${VITE_API_URL}
RUN pnpm --filter web build

# Last stage, so CI builds and publishes it by default: built files served by nginx.
FROM nginx:alpine AS prod
# Pull security patches released since the base image was published.
RUN apk upgrade --no-cache
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
