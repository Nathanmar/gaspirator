# Environment Configuration
# Copy this file to .env and update the values

# Application
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Allowed web origin for CORS (unset or empty = allow any origin)
CORS_ORIGIN=http://localhost:5173

# Database (if using SQLAlchemy/SQLModel)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gaspirator

# JWT signing
SECRET_KEY=change-me-to-a-long-random-secret

# Celery (if using task queue)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# PostgreSQL (docker compose up -d db). Dans le compose, le service app la remplace par l'hôte "db".
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/gaspirator
# Clé de signature des JWT : à générer, ne jamais réutiliser celle d'exemple
SECRET_KEY=jaLtnMUSgJ8_9gvSnU9AYUiNONHJtII_fo40vZ5ZVrY_p3rvesAJVf3cTNLr2Bkq
# Optionnel : durées de vie des tokens (secondes)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# E-mails : Mailpit en développement (docker compose up -d mailpit, boîte sur http://localhost:8025).
# Dans le compose, le service app utilise l'hôte "mailpit". Sans SMTP_HOST, les e-mails vont dans les logs.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Gaspirator <noreply@gaspirator.fr>

# Development data (suppliers, associations, lots), inserted once on an empty database.
# Local development only: never set it in production.
SEED_DEV_DATA=true