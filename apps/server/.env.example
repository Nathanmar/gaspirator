# Environment Configuration
# Copy this file to .env (scripts/start.sh does it): the values work as is with docker compose.
# Hosts are compose service names (db, mailpit); to run the API outside Docker, use localhost instead.

# Application
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Allowed web origin for CORS (unset or empty = allow any origin)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL: POSTGRES_* create the database in the db container, DATABASE_URL must match them.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gaspirator
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/gaspirator

# JWT signing key (hex32) - Fake here, replace with a real one
SECRET_KEY=jaLtnMUSgJ8_9gvSnU9AYUiNONHJtII_fo40vZ5ZVrY_p3rvesAJVf3cTNLr2Bkq

# Lifetimes of the tokens (seconds)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# SMTP: Mailpit catches every e-mail, inbox on http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=Gaspirator <noreply@gaspirator.fr>

# Seed development data (true/false)
SEED_DEV_DATA=true
