# Base URL of the API contract, without a trailing slash. Port 8000 is the FastAPI server (apps/server).
# Keep 127.0.0.1: on a phone or emulator the app swaps it for the computer running Metro
# (src/lib/api-url.ts), so the same value works on any device and Wi-Fi network.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
